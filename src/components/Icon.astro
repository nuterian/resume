---
/**
 * Mono-stroke line icons drawn on a 24px grid.
 *
 * They inherit `currentColor` and use a single stroke weight, so they print
 * legibly in black and white and never compete with the text they sit beside.
 * Deliberately generic shapes: no company or product marks.
 */
interface Props {
  name: keyof typeof paths;
  class?: string;
}

const paths = {
  // Contact marks
  mail: '<path d="M3 6.5h18v11H3z"/><path d="m3.4 7 8.6 6 8.6-6"/>',
  globe:
    '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.3 2.3 3.4 5.3 3.4 8.5S14.3 18.2 12 20.5c-2.3-2.3-3.4-5.3-3.4-8.5S9.7 5.8 12 3.5Z"/>',
  phone:
    '<path d="M8.4 3.6 10.6 8l-2 2a12 12 0 0 0 5.4 5.4l2-2 4.4 2.2v3a1.6 1.6 0 0 1-1.8 1.6C10.9 19.5 4.5 13.1 3.4 5.4A1.6 1.6 0 0 1 5 3.6Z"/>',

  // Section marks
  profile: '<circle cx="12" cy="8" r="3.6"/><path d="M4.8 20.4a7.4 7.4 0 0 1 14.4 0"/>',
  experience:
    '<path d="M3.5 7.5h17v13h-17z"/><path d="M8.8 7.5V5.2a1.4 1.4 0 0 1 1.4-1.4h3.6a1.4 1.4 0 0 1 1.4 1.4v2.3"/><path d="M3.5 12.5h17"/>',
  skills: '<path d="m12 3.2 8.4 4.6-8.4 4.6-8.4-4.6z"/><path d="m4.4 12.4 7.6 4.2 7.6-4.2"/><path d="m4.4 16.6 7.6 4.2 7.6-4.2"/>',
  education: '<path d="m12 4 9.2 4.4L12 12.8 2.8 8.4z"/><path d="M6.6 10.6v5.2c0 1.6 2.4 3 5.4 3s5.4-1.4 5.4-3v-5.2"/>',
  honors:
    '<circle cx="12" cy="9.2" r="5.4"/><path d="m8.6 13.8-1.4 6.6 4.8-2.6 4.8 2.6-1.4-6.6"/>',
} as const;

const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
