---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Section from '../components/Section.astro';
import Job from '../components/Job.astro';
import { resume } from '../data/resume';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pdfUrl = `${base}/${resume.pdfFilename}`;

const [firstName, ...restName] = resume.name.split(' ');

const pageUrl = new URL(base + '/', Astro.site).href;
const ogImageUrl = new URL(base + '/og.png', Astro.site).href;

// A short, searchable summary: people look for a name plus a company or a
// role, so both need to appear early in the title and description.
const pageTitle = `${resume.name} · ${resume.title} · ${resume.experience[0].company.replace(' · ', ' / ')}`;
const metaDescription = `${resume.name} is a ${resume.title.toLowerCase()} based in ${resume.location}. ${resume.summary}`;

const skillList = resume.skills.flatMap((group) => group.items);
const teamNames = resume.experience.flatMap((job) => job.teams?.map((t) => t.name) ?? []);

// Structured data is generated from the same content the page renders, so
// it can never drift out of sync with what a reader sees.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: pageUrl,
  name: pageTitle,
  dateModified: new Date().toISOString().slice(0, 10),
  mainEntity: {
    '@type': 'Person',
    '@id': `${pageUrl}#person`,
    name: resume.name,
    jobTitle: resume.title,
    description: resume.summary,
    url: 'https://jugalm.com',
    email: 'mailto:jugalm9@gmail.com',
    sameAs: ['https://github.com/nuterian', 'https://jugalm.com'],
    address: {
      '@type': 'PostalAddress',
      addressLocality: resume.location,
      addressCountry: 'US',
    },
    knowsAbout: [...skillList, ...teamNames],
    worksFor: {
      '@type': 'Organization',
      name: 'YouTube',
      parentOrganization: { '@type': 'Organization', name: 'Google' },
    },
    alumniOf: resume.education.map((edu) => ({
      '@type': 'CollegeOrUniversity',
      name: edu.school,
    })),
    hasOccupation: {
      '@type': 'Occupation',
      name: resume.title,
      occupationLocation: { '@type': 'Place', name: resume.location },
      skills: skillList.join(', '),
    },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={resume.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={resume.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Resume of ${resume.name}, ${resume.title}`} />
    <meta property="profile:first_name" content={firstName} />
    <meta property="profile:last_name" content={restName.join(' ')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="color-scheme" content="light" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/pdf" href={pdfUrl} title={`${resume.name} resume (PDF)`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main class="sheet">
      <header class="masthead">
        <div>
          <h1><strong>{firstName}</strong> {restName.join(' ')}</h1>
          <p class="role">
            {resume.title}<span class="sep">◆</span>{resume.location}
          </p>
        </div>
        <ul class="contacts">
          {
            resume.contacts.map((contact) => (
              <li>
                <a href={contact.href}>{contact.label}</a>
              </li>
            ))
          }
        </ul>
      </header>

      <Section title="Profile" class="summary">
        <p>{resume.summary}</p>
      </Section>

      <Section title="Experience">
        {resume.experience.map((job) => <Job job={job} />)}
      </Section>

      <Section title="Skills" class="skills">
        <dl>
          {
            resume.skills.map((skillGroup) => (
              <>
                <dt>{skillGroup.group}</dt>
                <dd>
                  {skillGroup.items.map((item, i) => (
                    <>
                      {i > 0 && <span class="sep">◆</span>}
                      {item}
                    </>
                  ))}
                </dd>
              </>
            ))
          }
        </dl>
      </Section>

      <Section title="Education" class="education">
        {
          resume.education.map((edu) => (
            <div class="edu-row">
              <span>
                <span class="degree">{edu.degree}</span>
                <span class="sep">◆</span>
                <span class="school">{edu.school}</span>
                {edu.detail && <span class="detail">{edu.detail}</span>}
              </span>
              <span class="when">{edu.period}</span>
            </div>
          ))
        }
      </Section>

      {
        resume.honors.length > 0 && (
          <Section title="Honors" class="honors">
            {resume.honors.map((honor) => (
              <div class="honor">
                <h4>{honor.title}</h4>
                <p class="honor-sub">
                  {honor.subtitle}
                  <span class="sep">◆</span>
                  {honor.period}
                </p>
                <p class="honor-desc">{honor.description}</p>
              </div>
            ))}
          </Section>
        )
      }
    </main>

    <a class="pdf-link" href={pdfUrl} download aria-label="Download resume as PDF">
      <svg class="dl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <g class="dl-arrow">
          <path d="M12 3.5v10.5" />
          <path d="m7.4 9.6 4.6 4.6 4.6-4.6" />
        </g>
        <path class="dl-tray" d="M4.75 19.5h14.5" />
      </svg>
      <span>PDF</span>
    </a>
  </body>
</html>
